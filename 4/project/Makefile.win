CXXINCS  = -I"D:/downloadd/Dev-Cpp/MinGW64/include" -I"D:/downloadd/Dev-Cpp/MinGW64/x86_64-w64-mingw32/include" -I"D:/downloadd/Dev-Cpp/MinGW64/lib/gcc/x86_64-w64-mingw32/4.9.2/include" -I"D:/downloadd/Dev-Cpp/MinGW64/lib/gcc/x86_64-w64-mingw32/4.9.2/include/c++"
BIN      = project.exe
CXXFLAGS = $(CXXINCS) -O2 -g3 -std=c99
